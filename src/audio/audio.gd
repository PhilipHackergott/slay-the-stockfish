extends Node
## Music, ambience and sound effects from res://assets/audio (generated by tools/audio).
## Missing files are skipped, so the game also runs without them.

const SFX_DIR := "res://assets/audio/sfx/"
const MUSIC_DIR := "res://assets/audio/music/"
const VOICES := 12

var _cache: Dictionary = {}
var _voices: Array[AudioStreamPlayer] = []
var _next_voice := 0
var _music: Array[AudioStreamPlayer] = []
var _music_on := 0
var _current_music := ""
var _ambience: AudioStreamPlayer
var _loops: Dictionary = {}
var _last_play: Dictionary = {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for bus in ["Music", "Sfx"]:
		if AudioServer.get_bus_index(bus) < 0:
			AudioServer.add_bus()
			var i := AudioServer.bus_count - 1
			AudioServer.set_bus_name(i, bus)
			AudioServer.set_bus_send(i, "Master")
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = "Sfx"
		add_child(p)
		_voices.append(p)
	for i in 2:
		var m := AudioStreamPlayer.new()
		m.bus = "Music"
		m.volume_db = -80.0
		add_child(m)
		_music.append(m)
	_ambience = AudioStreamPlayer.new()
	_ambience.bus = "Music"
	add_child(_ambience)
	apply_settings()


func apply_settings() -> void:
	AudioServer.set_bus_volume_db(0, float(Profile.setting("master_db", 0.0)))
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Music"), float(Profile.setting("music_db", -6.0)))
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Sfx"), float(Profile.setting("sfx_db", -2.0)))


func _stream(path: String, loop: bool = false) -> AudioStream:
	if _cache.has(path):
		return _cache[path]
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		s = load(path) as AudioStream
		if s != null and loop:
			if s is AudioStreamOggVorbis:
				(s as AudioStreamOggVorbis).loop = true
			elif s is AudioStreamWAV:
				var w := s as AudioStreamWAV
				w.loop_mode = AudioStreamWAV.LOOP_FORWARD
				w.loop_end = int(w.get_length() * w.mix_rate)
	_cache[path] = s
	return s


## One-shot sound effect. Repeats of the same sound within 40 ms are dropped.
func play(sfx: String, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	var s := _stream(SFX_DIR + sfx + ".wav")
	if s == null:
		return
	var now := Time.get_ticks_msec()
	if now - int(_last_play.get(sfx, -1000)) < 40:
		return
	_last_play[sfx] = now
	var p := _voices[_next_voice]
	_next_voice = (_next_voice + 1) % VOICES
	p.stream = s
	p.volume_db = volume_db
	p.pitch_scale = pitch
	p.play()


## Looping sound effect (heartbeat, whisper) on or off.
func loop(sfx: String, on: bool, volume_db: float = 0.0) -> void:
	if not on:
		if _loops.has(sfx):
			_loops[sfx].queue_free()
			_loops.erase(sfx)
		return
	if _loops.has(sfx):
		return
	var s := _stream(SFX_DIR + sfx + ".wav", true)
	if s == null:
		return
	var p := AudioStreamPlayer.new()
	p.bus = "Sfx"
	p.stream = s
	p.volume_db = volume_db
	add_child(p)
	p.play()
	_loops[sfx] = p


## Cross-fades to a music loop ("" fades out).
func music(track: String, fade: float = 1.6) -> void:
	if track == _current_music:
		return
	_current_music = track
	var old := _music[_music_on]
	_music_on = 1 - _music_on
	var nxt := _music[_music_on]
	var tw := create_tween().set_parallel(true)
	tw.tween_property(old, "volume_db", -80.0, fade)
	tw.chain().tween_callback(old.stop)
	if track == "":
		return
	var s := _stream(MUSIC_DIR + track + ".ogg", true)
	if s == null:
		return
	nxt.stream = s
	nxt.volume_db = -40.0
	nxt.play()
	create_tween().tween_property(nxt, "volume_db", 0.0, fade)


func ambience(track: String, volume_db: float = -10.0) -> void:
	var s := _stream(MUSIC_DIR + track + ".ogg", true) if track != "" else null
	if s == null:
		_ambience.stop()
		return
	if _ambience.stream == s and _ambience.playing:
		return
	_ambience.stream = s
	_ambience.volume_db = volume_db
	_ambience.play()
