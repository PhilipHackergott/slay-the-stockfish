[gd_resource type="Resource" script_class="ArenaDef" format=3]

[ext_resource type="Script" path="res://src/data/arena_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"gorgon_cloister"
display_name = "Gorgon Cloister"
description = "A rook, bishop, knight or queen that captures turns to stone where it lands and stays as a statue. Pawns, kings and fairy pieces are spared. Your statues wake after the fight."
icon = "res://assets/ui/icons/icon_arena_gorgon_256.png"
ini_lines = PackedStringArray("petrifyOnCaptureTypes = rbnq")
