[resource]
script = ExtResource("1")
id = &"tolling_bells"
display_name = "Tolling Bells"
description = "Every check tolls a bell. The third check wins, for either side."
icon = "res://assets/ui/icons/icon_arena_bells_256.png"
ini_lines = PackedStringArray("checkCounting = true")
