[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://src/data/event_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"engine_riddle"
title = "The Engine's Riddle"
text = "A panel in the throne room lights up: a position, and a line of text. MATE IN 2. THE ENGINE DEFENDS. It has never lost this one, it says. It has never been asked."
options = Array[Dictionary]([{"label": "Attempt the problem", "fight": "puzzle", "tier": 3, "detail": "Mate in two against the engine at full strength, with its pieces, not yours. Solve it: a relic, most likely a rare one. Fail: lose 35 gold.", "win": {"effect": "gain_relic", "source": "roamer", "result": "The panel goes dark with a sound like a sigh. A drawer slides open."}, "lose": {"effect": "lose_gold", "amount": 35, "result": "MATE NOT FOUND, the panel writes, and charges you for the attempt."}}, {"label": "Do not touch it", "effect": "nothing", "result": "The panel writes YOU ARE WISE and does not mean it."}])
acts = PackedInt32Array(3)
icon = "res://assets/ui/icons/icon_event_puzzle_256.png"
