[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://src/data/event_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"merchant_of_bones"
title = "The Merchant of Bones"
text = "A hunched figure has laid out pieces on a shroud: some carved, some grown. \"Gold for bone,\" it whispers. \"Or bone for gold.\""
options = Array[Dictionary]([{"label": "Buy a strange piece", "detail": "A random piece of this act's top recruit tier joins you.", "effect": "gain_piece_tier", "cost": "gold", "cost_amount": 40, "result": "The merchant wraps something that twitches."}, {"label": "Sell him a pawn (+30 gold, lose a pawn)", "effect": "gold", "amount": 30, "cost": "lose_pawn", "result": "He weighs the pawn in his palm and pays without haggling."}, {"label": "Walk past", "effect": "nothing", "result": "His eyes follow you down the stair."}])
acts = PackedInt32Array(3)
