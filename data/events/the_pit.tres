[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://src/data/event_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"the_pit"
title = "The Pit"
text = "A ring of bones around a hole in the floor. Down there, pieces fight for an audience of skulls. Nobody in the pit ever dies for good; the bones see to that."
options = Array[Dictionary]([{"label": "Go down into the pit", "fight": "skirmish", "encounter": "pit_rabble", "units": 3, "detail": "Your king and your three greenest pieces fight a small engine army. No piece of yours stays dead, and they keep the XP they take. Win: 30 gold.", "win": {"effect": "gold", "amount": 30, "result": "The crowd above throws coins and bones. You keep the coins."}, "lose": {"effect": "nothing", "result": "You are hauled out by your collars. Nobody died, which the crowd finds disappointing."}}, {"label": "Watch from the rim", "effect": "nothing", "result": "Someone below loses and gets back up, and loses again."}])
acts = PackedInt32Array(1)
icon = "res://assets/ui/icons/icon_event_pit_256.png"
